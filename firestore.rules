rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPlan() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan;
    }

    function isPaid() {
      return isSignedIn() && userPlan() == 'paid';
    }

    // Fields a client must never change on its own user doc
    function protectedFieldsUnchanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['plan', 'planExpiresAt', 'postsThisMonth']) == false;
    }

    // ---------- Users ----------
    match /users/{uid} {
      allow read: if isOwner(uid);

      // New users can only start on the free plan
      allow create: if isOwner(uid)
                    && request.resource.data.plan == 'free';

      // Users can edit profile fields, but NOT their plan or quota
      allow update: if isOwner(uid) && protectedFieldsUnchanged();

      allow delete: if false;
    }

    // ---------- Posts ----------
    match /posts/{postId} {
      // Free users see basic posts; paid users see everything.
      // Authors can always see their own posts.
      allow read: if isSignedIn() && (
        resource.data.tier == 'basic'
        || isPaid()
        || resource.data.authorId == request.auth.uid
      );

      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200;

      allow update, delete: if isSignedIn()
                            && resource.data.authorId == request.auth.uid
                            && request.resource.data.authorId == resource.data.authorId;
    }

    // ---------- Everything else is denied ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}